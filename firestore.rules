rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid == "KZshap0tcuWFQE20nqipwBxsj4e2"
        && exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ).data.role == "admin";
    }

    match /users/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid || isAdmin());

      allow create: if signedIn()
        && (
          (
            request.auth.uid == uid
            &&
            !request.resource.data.keys().hasAny([
              "role",
              "isAdmin",
              "admin",
              "permissions",
              "adminPermissions"
            ])
          )
          || isAdmin()
        );

      allow update: if signedIn()
        && (
          (
            request.auth.uid == uid
            &&
            !request.resource.data.keys().hasAny([
              "role",
              "isAdmin",
              "admin",
              "permissions",
              "adminPermissions"
            ])
          )
          || isAdmin()
        );

      allow delete: if isAdmin();

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /admins/{uid} {
      // An admin must be able to read their own allow-list document so the
      // client can verify role == "admin". Writes remain blocked from clients.
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
